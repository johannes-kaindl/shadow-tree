        "folder-suggest",
        "help-setting",
        "settings_walker"
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock"
      ]
    }
  ]
